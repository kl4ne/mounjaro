{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "None",
    "strict": true,
    "noImplicitAny": true,
    "useUnknownInCatchVariables": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "useDefineForClassFields": true,
    "rootDir": "src/runtime",
    "outDir": "public/runtime",
    "noEmit": false,
    "declaration": false,
    "sourceMap": false,
    "removeComments": false
  },
  "include": [
    "src/runtime/**/*.ts",
    "src/runtime/**/*.d.ts"
  ]
}

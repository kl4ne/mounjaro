{
  "name": "glp1-companion",
  "private": true,
  "version": "5.6.1",
  "type": "module",
  "scripts": {
    "dev": "npm run build:generated && vite",
    "typecheck:core": "tsc -p tsconfig.json --noEmit",
    "typecheck:runtime": "tsc -p tsconfig.runtime.json --noEmit",
    "typecheck:sw": "tsc -p tsconfig.sw.json --noEmit",
    "typecheck:tools": "tsc -p tsconfig.tools.json --noEmit",
    "typecheck": "npm run typecheck:core && npm run typecheck:runtime && npm run typecheck:sw && npm run typecheck:tools",
    "build:runtime": "tsc -p tsconfig.runtime.emit.json",
    "build:sw": "tsc -p tsconfig.sw.json",
    "clean:generated": "node scripts/clean-generated.mjs",
    "build:generated": "npm run clean:generated && npm run build:runtime && npm run build:sw",
    "build": "npm run verify:source && npm run typecheck && npm run build:generated && vite build && npm run verify:dist",
    "preview": "vite preview",
    "verify:dist": "node scripts/verify-dist.mjs",
    "verify:source": "node scripts/verify-source.mjs",
    "verify:yaml": "node scripts/verify-yaml.mjs .github/workflows/deploy.yml",
    "verify:fixtures": "node scripts/verify-v561-fixtures.mjs",
    "verify:generated-js": "node scripts/verify-generated-js.mjs"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.8.3",
    "vite": "8.0.0",
    "yaml": "2.8.1"
  },
  "dependencies": {
    "chart.js": "4.5.1",
    "firebase": "12.19.0",
    "lucide": "1.46.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
